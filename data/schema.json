{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "avatar": { "type": "string" },
    "name": { "type": "string" },
    "subtitle": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "website": { "type": "string", "format": "uri" },
    "resume": { "type": "string" },
    "about": { "type": "string" },
    "heroSummary": { "type": "string" },
    "socials": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "company": { "type": "string" },
          "period": { "type": "string" },
          "logo": { "type": "string" },
          "highlights": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["role", "company", "period"]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "live": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["title", "description", "tags"]
      }
    },
    "skills": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      ]
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": { "type": "string" },
          "school": { "type": "string" },
          "period": { "type": "string" }
        },
        "required": ["degree", "school", "period"]
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "logo": { "type": "string" },
          "credentialUrl": { "type": "string" }
        },
        "required": ["name", "organization"]
      }
    }
  },
  "required": ["name", "email"]
}
